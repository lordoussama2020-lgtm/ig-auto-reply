# Copy this file to `.env` and fill in your values.
# NEVER commit .env or paste these tokens in chat.

# Page access token (long-lived) for the Facebook Page linked to @oussama_ai_lab.
# Get it from Meta's Graph API Explorer or your app dashboard.
PAGE_ACCESS_TOKEN=

# Any random string you invent — Meta must send the same one back
# when you subscribe the webhook. Example: ig-reply-2026-secret
VERIFY_TOKEN=ig-auto-reply-verify

# App Secret from your Meta app dashboard (Settings > Basic).
# Used to verify webhook signatures. Leave empty only for local tests.
APP_SECRET=

# 1 = log what WOULD be sent, send nothing (safe testing).
# 0 = live mode, real DMs go out.
DRY_RUN=1

# Delay between a comment arriving and the DM (ms). Meta wants ~10s minimum.
REPLY_DELAY_MS=12000

# Poller fallback: comma-separated Instagram media IDs to check for
# new comments (the reel/post IDs). Leave empty for webhook-only mode.
# Example: POLL_MEDIA_IDS=18133189795686126,18126562072922700
POLL_MEDIA_IDS=

# Poll every X minutes (only used when POLL_MEDIA_IDS is set).
POLL_INTERVAL_MIN=5

# Graph API version (private replies exist since v18).
GRAPH_VERSION=v21.0

# Server port (Render sets PORT automatically).
PORT=3000
